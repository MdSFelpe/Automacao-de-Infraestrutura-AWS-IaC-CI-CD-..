# ==========================================
# TERRAFORM (Core & State Files)
# ==========================================
# Local .terraform directories (provider binaries & modules)
.terraform/

# State files (contains sensitive infra metadata)
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Crash logs
crash.log
crash.*.log

# CLI configurations
.terraformrc
terraform.rc

# ==========================================
# TERRAFORM (Variables & Secrets)
# ==========================================
# Ignore all variables files with credentials/secrets
*.tfvars
*.tfvars.json

# Whitelist the example variable file for GitHub documentation
!terraform.tfvars.example

# ==========================================
# TERRAFORM (Overrides & Execution Plans)
# ==========================================
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore plan output files generated by 'terraform plan -out=...'
*tfplan*
planout

# Optional graph output
*.dot

# ==========================================
# AWS & SECURITY CREDENTIALS
# ==========================================
# Ignore local SSH keys and AWS credential files if stored in the project
*.pem
*.pub
aws-credentials*
credentials.json

# ==========================================
# OS & IDE TEMP FILES
# ==========================================
# Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code & Editors
.vscode/
.idea/
*.swp
*.swo
*~